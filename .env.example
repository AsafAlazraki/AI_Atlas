# Copy this file to .env.local for local development.
# In CI/CD, set these per branch (dev / test / prod).

# --- Branch / environment identity ---
# Drives which Firestore collection set this build reads/writes.
# Examples: dev_, test_, prod_   (note the trailing underscore)
VITE_FIRESTORE_PREFIX=dev_
VITE_APP_ENV=dev

# --- Firebase web app config ---
# Pull from Firebase Console > Project Settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
